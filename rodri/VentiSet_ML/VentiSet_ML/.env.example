# Reemplaza por endpoints de tu API HTTPS de AWS (API Gateway/Lambda, servidor propio, etc.)
AWS_GET_URL=https://example.execute-api.us-east-1.amazonaws.com/measurements
AWS_POST_URL=https://example.execute-api.us-east-1.amazonaws.com/anomalies
AWS_API_KEY=
POLL_SECONDS=2
CONSECUTIVE_ANOMALIES=3
# DRY RUN por defecto: nunca manda una orden a AWS hasta habilitarlo explicitamente.
ENABLE_REMOTE_SHUTDOWN=false
# El servicio AWS debe autorizar y transmitir OFF al dispositivo; este cliente no abre COM.
